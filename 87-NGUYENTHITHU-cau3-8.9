#include <iostream>
using namespace std;

int main()
{
    int S;

    for (int i = 1; i < 100; i++)
    {
        S = 0;

        for (int j = 1; j < i; j++)
        {
            if (i % j == 0)
            {
                S = S + j;
            }
        }

        if (S == i)
        {
            cout << i << " ";
        }
    }

    return 0;
}
